                  style={{ width: progress.total > 0 ? `${(progress.done / progress.total) * 100}%` : "0%", background: "#D97706" }}
                />
              </div>
              <p className="text-center text-xs text-white/40">Don't close the app</p>
            </div>
          )}

          {importStatus === "done" && (
            <div className="space-y-4">
