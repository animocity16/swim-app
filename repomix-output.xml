  }

  /* Select */
  select.input {
    appearance: none;
    -webkit-appearance: none;
    color: white;
  }

  select.input option {
    background: var(--theme-bg);
    color: white;
  }

  /* Buttons */
  .btn {
    @apply inline-flex items-center justify-center rounded-[20px] px-4 py-3 text-sm font-semibold transition disabled:cursor-not-allowed disabled:opacity-50;
    background: rgba(217,119,6,0.25);
    border: 1px solid rgba(253,230,138,0.35);
    color: #FDE68A;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .btn:hover:not(:disabled) {
    background: rgba(217,119,6,0.35);
    border-color: rgba(253,230,138,0.5);
  }

  .btn-block {
    @apply inline-flex h-14 w-full items-center justify-center rounded-[20px] px-4 text-base font-semibold transition disabled:cursor-not-allowed disabled:opacity-50;
    background: rgba(217,119,6,0.25);
    border: 1px solid rgba(253,230,138,0.35);
    color: #FDE68A;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
