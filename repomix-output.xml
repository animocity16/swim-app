@import "tailwindcss";

/* ============================================================
   NATRIX — Water Glass Theme
   Pool caustic light + frosted glass cards
   ============================================================ */

:root {
  --foreground: #ffffff;

  /* ── Theme background variables ──────────────────────────────
     These are overridden at runtime by ThemeProvider.tsx.
     Defaults = Ocean (the original blue).
  ─────────────────────────────────────────────────────────── */
  --theme-bg:     #063554;
  --theme-dark:   #073E6A;
  --theme-mid:    #084A73;
  --theme-light:  #0D6E9A;
  --theme-light2: #0E7A9E;
  --theme-light3: #0A5580;
  --theme-nav-bg: rgba(6,53,84,0.80);

  /* Kept for backwards compat — mirrors --theme-bg */
  --background: var(--theme-bg);

  /* Amber accent palette */
  --amber:        #D97706;
  --amber-light:  #FDE68A;
  --amber-glow:   rgba(217,119,6,0.35);

  /* Glass surfaces */
  --glass-bg:           rgba(255,255,255,0.13);
  --glass-bg-hover:     rgba(255,255,255,0.18);
  --glass-border:       rgba(255,255,255,0.24);
  --glass-border-hover: rgba(255,255,255,0.38);

  /* Text */
  --text-primary:   #ffffff;
  --text-secondary: rgba(255,255,255,0.65);
  --text-muted:     rgba(255,255,255,0.38);
  --text-hint:      rgba(255,255,255,0.22);
}

/* ============================================================
   BASE
   ============================================================ */

*, *::before, *::after {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  padding: 0;
  min-height: 100vh;
  color: var(--foreground);
  font-family: -apple-system, 'SF Pro Display', 'Helvetica Neue', Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

a {
  color: inherit;
  text-decoration: none;
}

button, input, select, textarea {
  font: inherit;
}

/* ============================================================
   WATER BACKGROUND — CSS animated pool caustics
   Uses CSS variables so ThemeProvider can change colours.
   GPU-accelerated on iOS Safari.
   ============================================================ */

body {
  background-color: var(--theme-bg);
  position: relative;
  isolation: isolate;
  transition: background-color 0.6s ease;
}

/* Layer 1 — Deep water base gradient */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: -2;
  background:
    radial-gradient(ellipse 60% 50% at 15% 25%, var(--theme-light)  0%, transparent 65%),
    radial-gradient(ellipse 50% 60% at 85% 55%, var(--theme-dark)   0%, transparent 60%),
    radial-gradient(ellipse 70% 40% at 50% 85%, var(--theme-light3) 0%, transparent 65%),
    radial-gradient(ellipse 40% 30% at 70% 15%, var(--theme-light2) 0%, transparent 55%),
    linear-gradient(160deg, var(--theme-bg) 0%, var(--theme-mid) 40%, var(--theme-bg) 100%);
  animation: waterDepth 25s ease-in-out infinite alternate;
  pointer-events: none;
  transition: background 0.6s ease;
}

/* Layer 2 — Caustic light shimmer (pool light refraction) */
body::after {
  content: '';
  position: fixed;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(ellipse 220px 110px at 25% 35%, rgba(140,210,255,0.12) 0%, transparent 70%),
    radial-gradient(ellipse 180px  90px at 75% 25%, rgba(255,200, 80,0.08) 0%, transparent 65%),
    radial-gradient(ellipse 200px 100px at 60% 65%, rgba(120,200,240,0.10) 0%, transparent 70%),
    radial-gradient(ellipse 150px  80px at 30% 75%, rgba(255,180, 40,0.06) 0%, transparent 60%),
    radial-gradient(ellipse 250px 120px at 80% 80%, rgba(100,190,230,0.09) 0%, transparent 70%);
  animation: causticLight 18s ease-in-out infinite alternate-reverse;
  pointer-events: none;
}

@keyframes waterDepth {
  0%   { transform: translate(0px,   0px)  scale(1);    }
  25%  { transform: translate(18px, -12px) scale(1.03); }
  50%  { transform: translate(-14px, 20px) scale(0.98); }
  75%  { transform: translate(10px,  -8px) scale(1.02); }
  100% { transform: translate(-8px,  15px) scale(1.01); }
}

@keyframes causticLight {
  0%   { transform: translate(0px,   0px); opacity: 0.7;  }
  30%  { transform: translate(-28px, 18px); opacity: 1;   }
  60%  { transform: translate(22px, -15px); opacity: 0.75; }
  100% { transform: translate(-12px, 25px); opacity: 0.85; }
}

/* Subtle ripple lines overlay — pool surface effect */
.water-ripple {
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background-image: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 28px,
    rgba(255,255,255,0.018) 28px,
    rgba(255,255,255,0.018) 29px
  );
  animation: rippleMove 12s linear infinite;
}

@keyframes rippleMove {
  from { transform: translateY(0); }
  to   { transform: translateY(29px); }
}

/* ============================================================
   GLASS UTILITY — reusable glass surface
   ============================================================ */

.glass {
  background: var(--glass-bg);
  backdrop-filter: blur(24px) saturate(1.4);
  -webkit-backdrop-filter: blur(24px) saturate(1.4);
  border: 1px solid var(--glass-border);
}

/* ============================================================
   COMPONENT LAYER
   ============================================================ */

@layer components {

  /* Shell — full page wrapper, transparent so water shows through */
  .shell {
    @apply min-h-screen text-white;
    background: transparent;
    position: relative;
    z-index: 1;
  }

  /* Content container */
  .container-app {
    @apply mx-auto w-full max-w-md px-4 pt-6 pb-28;
  }

  /* Card — frosted glass */
  .card {
    background: rgba(255,255,255,0.13);
    backdrop-filter: blur(24px) saturate(1.3);
    -webkit-backdrop-filter: blur(24px) saturate(1.3);
    border: 1px solid rgba(255,255,255,0.24);
    border-radius: 28px;
    padding: 20px;
  }

  /* Card soft — lighter glass */
  .card-soft {
    background: rgba(255,255,255,0.09);
    backdrop-filter: blur(20px) saturate(1.2);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 24px;
    padding: 16px;
