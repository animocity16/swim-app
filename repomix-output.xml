            <p className="text-[10px] text-white/25 text-center mt-2">
              Dates indicative only · Source: Singapore Aquatics
            </p>
          </div>
        )}

        {/* Standards arc */}
        {standardsSummary && standardsSummary.total > 0 && (
          <Link href={`/swimmers/${primarySwimmer.id}?tab=standards`}
