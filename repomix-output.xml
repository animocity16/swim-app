  // ── Step 4: Install on your phone ────────────────────────────────────────

  if (step === 4) return (
    <div className="onb-screen">
      <StepDots total={TOTAL_STEPS} current={4} />
      <div className="px-6 space-y-5">
        <div className="text-center">
