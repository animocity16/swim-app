                style={{ background: "rgba(239,68,68,0.25)", border: "1px solid rgba(239,68,68,0.4)", color: "#FCA5A5" }}
              >
                {deletingAccount ? "Deleting..." : "Permanently delete account"}
              </button>
            </div>
          )}
        </div>

        <div className="h-4" />
