            </div>
            <p className="text-center text-sm text-white/40">Reading screenshot</p>
          </div>
        )}

        {/* DONE */}
        {step === "done" && (
          <div className="space-y-4">

            {/* Message */}
            {message && (
              <div
                className="rounded-2xl border p-3 text-sm"
